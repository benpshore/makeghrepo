
  ruby:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Ruby 3.4 from the runner tool cache
        run: |
          bin="$(printf '%s\n' "$RUNNER_TOOL_CACHE"/Ruby/3.4.*/*/bin | sort -V | tail -1)"
          test -x "$bin/bundle" || { echo "::error::no Ruby 3.4 with bundler under $RUNNER_TOOL_CACHE/Ruby"; exit 1; }
          echo "$bin" >> "$GITHUB_PATH"
      - run: bundle install
      - run: bundle exec rubocop
      - run: bundle exec rake test
