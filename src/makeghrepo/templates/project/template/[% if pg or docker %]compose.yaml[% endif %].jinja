# Local development only. Credentials here are not secrets.
services:
[% if docker %]
  app:
    build: .
    volumes:
      - appdata:/data
[% if pg %]
    depends_on:
      db:
        condition: service_healthy
[% endif %]
[% endif %]
[% if pg %]
  db:
    image: postgres:17
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: app
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./db/migrations:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app"]
      interval: 2s
      retries: 15
[% endif %]

volumes:
[% if docker %]
  appdata:
[% endif %]
[% if pg %]
  pgdata:
[% endif %]
