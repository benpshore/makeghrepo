[project]
name = "[[ project_name ]]"
dynamic = ["version"]
description = [[ description | to_json(ensure_ascii=False) ]]
readme = "README.md"
[% if project_license == "MIT" %]
license = "MIT"
[% endif %]
authors = [{ name = [[ author_name | to_json(ensure_ascii=False) ]] }]
requires-python = ">=3.14"
dependencies = []

[% if not py_lib %]
[project.scripts]
[[ project_name ]] = "[[ package_name ]]:main"

[% endif %]
# The version is the git tag (v1.2.3 -> 1.2.3); nothing to bump by hand.
[build-system]
requires = ["hatchling>=1.32,<2", "uv-dynamic-versioning>=0.14,<1"]
build-backend = "hatchling.build"

[tool.hatch.version]
source = "uv-dynamic-versioning"

[tool.hatch.build.targets.wheel]
packages = ["src/[[ package_name ]]"]

[tool.uv-dynamic-versioning]
fallback-version = "0.0.0"

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.14"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "RUF", "S"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["-ra", "--strict-markers"]
