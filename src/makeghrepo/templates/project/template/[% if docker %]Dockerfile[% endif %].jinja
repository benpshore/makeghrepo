[% if py %]
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --locked --no-dev
ENV APP_DATA=/data
VOLUME ["/data"]
USER 65534:65534
CMD ["/app/.venv/bin/[[ project_name ]]"]
[% elif rs %]
FROM rust:1-slim-bookworm AS build
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=build /app/target/release/[[ project_name ]] /usr/local/bin/app
ENV APP_DATA=/data
VOLUME ["/data"]
USER 65534:65534
CMD ["app"]
[% elif js %]
FROM node:24-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src ./src
ENV APP_DATA=/data
VOLUME ["/data"]
USER 1000:1000
CMD ["node", "-e", "import('./src/index.js').then(m => console.log(m.greeting()))"]
[% elif go %]
FROM golang:1-bookworm AS build
WORKDIR /app
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/app .

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/app /app
ENV APP_DATA=/data
VOLUME ["/data"]
USER 65532:65532
CMD ["/app"]
[% elif ts %]
FROM node:24-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src ./src
ENV APP_DATA=/data
VOLUME ["/data"]
USER 1000:1000
CMD ["node", "-e", "import('./src/index.ts').then(m => console.log(m.greeting()))"]
[% elif rb %]
FROM ruby:3.4-slim
WORKDIR /app
ENV BUNDLE_PATH=/app/vendor/bundle BUNDLE_WITHOUT=development
COPY Gemfile Gemfile.lock ./
RUN bundle install
COPY lib ./lib
ENV APP_DATA=/data
VOLUME ["/data"]
USER 65534:65534
CMD ["ruby", "-Ilib", "-e", "require '[[ package_name ]]'; puts [[ package_name | replace('_', ' ') | title | replace(' ', '') ]].greeting"]
[% else %]
FROM alpine:3
WORKDIR /app
COPY . .
ENV APP_DATA=/data
VOLUME ["/data"]
USER 65534:65534
CMD ["echo", "Hello from [[ project_name ]]!"]
[% endif %]
