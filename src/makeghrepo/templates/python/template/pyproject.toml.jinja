[project]
name = "{{ project_name }}"
version = "0.1.0"
description = {{ description | to_json(ensure_ascii=False) }}
readme = "README.md"
license = "MIT"
authors = [{ name = {{ author_name | to_json(ensure_ascii=False) }}{% if author_email %}, email = {{ author_email | to_json(ensure_ascii=False) }}{% endif %} }]
requires-python = {{ (">=" ~ python_version) | to_json(ensure_ascii=False) }}
dependencies = []

[project.scripts]
{{ project_name }} = "{{ package_name }}:main"

[build-system]
requires = ["uv_build>=0.9,<1"]
build-backend = "uv_build"

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.14"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "RUF", "S"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["-ra", "--strict-markers"]
