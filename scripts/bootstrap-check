#!/usr/bin/env python3
"""Exercise installed CLIs against real local Git and a controlled GitHub fixture.

No GitHub requests or live configuration changes occur. Only the GitHub CLI and
Git's network transport are substituted; rendering, git init/commit/push and
resume run through the installed production executable.
"""

# Assertions are intentional in this standalone acceptance test.
# ruff: noqa: S101

from __future__ import annotations

import argparse
import fcntl
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

OWNER = "acceptance-owner"
OWNER_ID = 42


def state_path():
    return Path(os.environ["ACCEPTANCE_STATE"])


def transaction(change):
    path = state_path()
    with path.open("r+") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        state = json.load(stream)
        result = change(state)
        stream.seek(0)
        json.dump(state, stream)
        stream.truncate()
        return result


def record(state, kind, **fields):
    event = {"kind": kind, **fields}
    state["events"].append(event)
    return event


def git_fixture(args):
    real = os.environ["ACCEPTANCE_GIT"]
    if "push" not in args and "ls-remote" not in args:
        return subprocess.run([real, *args], check=False).returncode
    kind = "push" if "push" in args else "lookup"

    def event(state):
        record(state, kind)
        return state["repo"], state.get("failure")

    repo, failure = transaction(event)
    if kind == "lookup" and failure == "lookup":
        print("controlled transport failure", file=sys.stderr)
        return 128
    remote = state_path().parent / "remote.git"
    rewrite = f"url.{remote.as_uri()}.insteadOf=https://github.com/{repo}.git"
    return subprocess.run([real, "-c", rewrite, *args], check=False).returncode


def gh_fixture(args):
    body = json.load(sys.stdin) if "--input" in args else None
    real = os.environ["ACCEPTANCE_GIT"]

    def handle(state):
        if args == ["api", "--include", "--silent", "user"]:
            if state.get("failure") == "preflight":
                return 0, "X-OAuth-Scopes: repo, workflow"
            return 0, "X-OAuth-Scopes: repo, workflow, project"
        if args[:2] == ["project", "list"]:
            return 0, json.dumps({"projects": state.get("projects", [])})
        if args[:2] == ["api", "user"]:
            return 0, OWNER
        if args[:2] == ["repo", "view"]:
            return (0, "{}") if state["created"] else (1, "Could not resolve to a Repository")
        if args[:2] == ["repo", "create"]:
            state["created"] = True
            state["private"] = "--private" in args
            source = args[args.index("--source") + 1]
            subprocess.run(
                [real, "init", "--bare", "-q", str(state_path().parent / "remote.git")], check=True
            )
            record(state, "create", private=state["private"])
            if state.get("failure") == "create":
                return 1, "controlled failure after remote creation, before adding origin"
            subprocess.run(
                [
                    real,
                    "-C",
                    source,
                    "remote",
                    "add",
                    "origin",
                    f"https://github.com/{state['repo']}.git",
                ],
                check=True,
            )
            return 0, ""
        if args[:2] == ["api", "graphql"]:
            query = " ".join(args)
            if "projectV2(number:" in query:
                record(state, "project-readback")
                linked = state.get("linked") and state.get("failure") != "project-readback"
                return 0, json.dumps(
                    {
                        "data": {
                            "user": {
                                "projectV2": {
                                    "title": state["repo"].split("/")[1],
                                    "repositories": {
                                        "nodes": [{"nameWithOwner": state["repo"]}]
                                        if linked
                                        else [],
                                        "pageInfo": {"hasNextPage": False, "endCursor": None},
                                    },
                                }
                            }
                        }
                    }
                )
            return 0, json.dumps(
                {
                    "data": {
                        "user": {
                            "projectsV2": {
                                "nodes": state.get("projects", []),
                            }
                        }
                    }
                }
            )
        if args[:2] == ["project", "create"]:
            project = {"number": 1, "title": state["repo"].split("/")[1]}
            state.setdefault("projects", []).append(project)
            record(state, "project-create")
            return 0, json.dumps(project)
        if args[:2] == ["project", "link"]:
            record(state, "project-link")
            if state.get("failure") == "project":
                return 1, "controlled project link failure after board creation"
            state["linked"] = True
            return 0, ""
        if args[:2] == ["label", "create"]:
            record(state, "label", name=args[2])
            if state.get("failure") == "labels":
                return 1, "controlled label failure"
            state.setdefault("labels", {})[args[2]] = args[args.index("--color") + 1]
            return 0, ""
        if args[:2] != ["api", "-X"]:
            return 1, "unexpected gh command: " + repr(args)
        method, path = args[2:4]
        event = record(state, "api", method=method, path=path, body=body, succeeded=True)
        prefix = "repos/" + state["repo"]
        if method == "GET" and path == prefix:
            return 0, json.dumps(
                {
                    **state.get("settings", {}),
                    "permissions": {"admin": True},
                    "private": state["private"],
                    "owner": {"type": "User", "login": OWNER, "id": OWNER_ID},
                }
            )
        if method == "GET" and path == "user":
            return 0, json.dumps({"login": OWNER, "id": OWNER_ID})
        if method == "PATCH" and path == prefix:
            if state.get("failure") == "settings":
                event["succeeded"] = False
                return 1, "controlled settings failure"
            state["settings"] = body
            if state.get("failure") == "settings-readback":
                state["settings"]["allow_merge_commit"] = True
        if path == prefix + "/actions/permissions":
            if state.get("failure") == "actions":
                event["succeeded"] = False
                return 1, "controlled Actions failure"
            if method == "GET":
                return 0, json.dumps(state.get("actions", {"enabled": True}))
            state["actions"] = body
            if state.get("failure") == "actions-readback":
                state["actions"]["enabled"] = True
        if "/rulesets" in path:
            if method == "GET":
                if "?" in path:
                    return 0, json.dumps(state["rulesets"])
                return 0, json.dumps(
                    next(r for r in state["rulesets"] if r["id"] == int(path.rsplit("/", 1)[1]))
                )
            if state.get("failure") == "ruleset":
                event["succeeded"] = False
                return 1, "controlled ruleset failure"
            if method == "POST":
                state["rulesets"].append({"id": len(state["rulesets"]) + 1, **body})
            elif method == "PUT":
                index = next(
                    i
                    for i, r in enumerate(state["rulesets"])
                    if r["id"] == int(path.rsplit("/", 1)[1])
                )
                state["rulesets"][index] = {"id": state["rulesets"][index]["id"], **body}
        suffix = path.removeprefix(prefix + "/")
        if suffix in {
            "vulnerability-alerts",
            "automated-security-fixes",
            "private-vulnerability-reporting",
            "subscription",
        }:
            if method == "PUT":
                if state.get("failure") == suffix:
                    event["succeeded"] = False
                    return 1, "controlled required setup failure"
                state[suffix] = body if body is not None else {"enabled": True}
            if method == "GET":
                if suffix == "vulnerability-alerts":
                    return (0, "") if suffix in state else (1, "404 disabled")
                value = state.get(suffix, {})
                if suffix == "automated-security-fixes":
                    value = {**value, "paused": False}
                return 0, json.dumps(value)
        if suffix.startswith("labels/") and method == "GET":
            name = suffix.split("/")[1]
            return 0, json.dumps({"name": name, "color": state["labels"].get(name, "")})
        return 0, "{}"

    code, output = transaction(handle)
    print(output, file=sys.stderr if code else sys.stdout)
    return code


def command(args, *, env, cwd=None, expected=0):
    result = subprocess.run(args, env=env, cwd=cwd, capture_output=True, text=True, timeout=90)
    if result.returncode != expected:
        raise RuntimeError(
            f"{args}: expected {expected}, got {result.returncode}\n{result.stdout}{result.stderr}"
        )
    return result.stdout.strip()


def read_state(root):
    return json.loads((root / "state.json").read_text())


def check_policy(state, private, python_gate=False):
    assert state["settings"]["allow_squash_merge"] is True
    assert state["settings"]["allow_merge_commit"] is False
    events = state["events"]
    push = next(i for i, e in enumerate(events) if e["kind"] == "push")
    if private:
        assert state["actions"] == {"enabled": False}
        assert not state["rulesets"]
        assert any(
            e["kind"] == "api"
            and e["succeeded"]
            and e["method"] == "PUT"
            and e["path"] == "repos/" + state["repo"] + "/actions/permissions"
            and e["body"] == {"enabled": False}
            for e in events[:push]
        )
    else:
        assert (
            state["settings"]["security_and_analysis"]["secret_scanning_push_protection"]["status"]
            == "enabled"
        )
        assert any(
            e["kind"] == "api"
            and e["succeeded"]
            and e["method"] == "PATCH"
            and e["path"] == "repos/" + state["repo"]
            and e["body"]
            .get("security_and_analysis", {})
            .get("secret_scanning_push_protection", {})
            .get("status")
            == "enabled"
            for e in events[:push]
        )
        rules = {r["name"]: r for r in state["rulesets"]}
        assert rules["protect-main"]["bypass_actors"] == []
        assert {r["type"] for r in rules["protect-main"]["rules"]} == {
            "deletion",
            "non_fast_forward",
            "required_linear_history",
        }
        gate = rules["require-pr-and-ci"]
        assert gate["bypass_actors"] == [
            {"actor_type": "User", "actor_id": OWNER_ID, "bypass_mode": "always"}
        ]
        assert {r["type"] for r in gate["rules"]} == {"pull_request", "required_status_checks"}
        check = next(r for r in gate["rules"] if r["type"] == "required_status_checks")
        assert check["parameters"]["strict_required_status_checks_policy"] is True
        assert check["parameters"]["required_status_checks"] == [
            {"context": "ci", "integration_id": 15368}
        ]

    if python_gate:
        before = events[:push]
        for suffix in ("vulnerability-alerts", "automated-security-fixes", "subscription"):
            assert any(
                e["kind"] == "api" and e["method"] == "GET" and e["path"].endswith("/" + suffix)
                for e in before
            )
        assert any(e["kind"] == "project-readback" for e in before)
        assert {e["name"] for e in before if e["kind"] == "label"} == {"epic", "task"}
        assert sum(e["kind"] == "create" for e in events) == 1
        assert sum(e["kind"] == "project-create" for e in events) == 1


def scenario(executable, private, failure, python_gate=False):
    real_git = shutil.which("git")
    assert real_git
    with tempfile.TemporaryDirectory(prefix="makeghrepo-bootstrap-") as temporary:
        root = Path(temporary)
        bin_dir = root / "bin"
        bin_dir.mkdir()
        script = Path(__file__).resolve()
        for name in ("gh", "git"):
            target = bin_dir / name
            target.write_text(
                f"#!{sys.executable}\nimport os, runpy\n"
                f"os.environ['ACCEPTANCE_TOOL'] = {name!r}\n"
                f"runpy.run_path({str(script)!r}, run_name='__main__')\n"
            )
            target.chmod(0o755)
        name = "acceptance-project"
        initial = {
            "repo": f"{OWNER}/{name}",
            "created": False,
            "private": private,
            "rulesets": [],
            "events": [],
            "failure": failure,
        }
        (root / "state.json").write_text(json.dumps(initial))
        config = root / "gitconfig"
        config.write_text("")
        env = os.environ | {
            "PATH": str(bin_dir) + os.pathsep + os.environ["PATH"],
            "ACCEPTANCE_STATE": str(root / "state.json"),
            "ACCEPTANCE_GIT": real_git,
            "MAKEGHREPO_DIR": str(root / "projects"),
            "GIT_CONFIG_GLOBAL": str(config),
            "GIT_CONFIG_NOSYSTEM": "1",
            # Unexpected Git transports fail closed; only our local bare repo is reachable.
            "GIT_ALLOW_PROTOCOL": "file",
            "GH_TOKEN": "synthetic-acceptance-token",
        }
        args = [executable, name, *(["--private"] if private else [])]
        start = time.monotonic()
        command(
            args,
            env=env,
            expected=(1 if failure in {"create", "preflight"} else 2) if failure else 0,
        )
        state = read_state(root)
        if failure == "preflight":
            assert not state["created"]
        if (python_gate and failure) or failure in {"settings", "actions"}:
            assert not any(e["kind"] == "push" for e in state["events"])
        if failure:
            state["failure"] = None
            (root / "state.json").write_text(json.dumps(state))
            command(args, env=env)
        project = root / "projects" / name
        assert not (project / "LICENSE").exists()
        marker = json.loads((project / ".git" / "makeghrepo.json").read_text())
        assert marker["private"] is private and marker["license"] == "none"
        state = read_state(root)
        check_policy(state, private, python_gate)
        remote_sha = command(
            [real_git, "--git-dir", str(root / "remote.git"), "rev-parse", "main"], env=env
        )
        assert remote_sha == command([real_git, "-C", str(project), "rev-parse", "HEAD"], env=env)
        # A later commit stays local during successful and failed configuration retries.
        (project / "later.txt").write_text("keep this local\n")
        command([real_git, "-C", str(project), "add", "later.txt"], env=env)
        command([real_git, "-C", str(project), "commit", "-qm", "later local work"], env=env)
        pushes = sum(e["kind"] == "push" for e in state["events"])
        command(args, env=env)
        assert (
            command([real_git, "--git-dir", str(root / "remote.git"), "rev-parse", "main"], env=env)
            == remote_sha
        )
        state = read_state(root)
        assert sum(e["kind"] == "push" for e in state["events"]) == pushes
        state["failure"] = "lookup"
        before = len(state["events"])
        (root / "state.json").write_text(json.dumps(state))
        command(args, env=env, expected=1)
        after = read_state(root)["events"][before:]
        assert not any(
            e["kind"] == "push" or (e["kind"] == "api" and e["method"] != "GET") for e in after
        )
        return {
            "private": private,
            "failure": failure,
            "elapsed_seconds": round(time.monotonic() - start, 3),
            "settings": state["settings"],
            "rulesets": state["rulesets"],
            "pushes": pushes,
        }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "executables", nargs="+", help="Installed Python and/or Rust executable paths"
    )
    parser.add_argument("--output", type=Path)
    parser.add_argument(
        "--python-executable",
        type=Path,
        help="Executable with the Python-only required setup/readback gate",
    )
    args = parser.parse_args()
    evidence = {}
    for executable in args.executables:
        executable = str(Path(executable).resolve())
        python_gate = bool(
            args.python_executable and executable == str(args.python_executable.resolve())
        )
        cases = [
            (False, None),
            (True, None),
            (False, "settings"),
            (True, "actions"),
            (False, "ruleset"),
        ]
        if python_gate:
            cases += [
                (False, failure)
                for failure in (
                    "preflight",
                    "create",
                    "settings-readback",
                    "vulnerability-alerts",
                    "automated-security-fixes",
                    "private-vulnerability-reporting",
                    "labels",
                    "subscription",
                    "project",
                    "project-readback",
                )
            ] + [(True, "settings"), (True, "actions-readback")]
        results = [
            scenario(executable, private, failure, python_gate) for private, failure in cases
        ]
        evidence[executable] = results
        print(f"{executable}: {len(results)} real-Git bootstrap/retry scenarios passed")
    normalized = []
    for results in evidence.values():
        comparable = json.loads(json.dumps(results[:5]))
        for result in comparable:
            result.pop("elapsed_seconds", None)
            # Python explicitly protects its bootstrap branch; the Rust CLI
            # still scopes these rulesets to the repository default branch.
            # Compare all remaining configuration exactly while preserving
            # that documented implementation gap.
            for ruleset in result["rulesets"]:
                include = ruleset["conditions"]["ref_name"]["include"]
                if "refs/heads/main" in include:
                    include.remove("refs/heads/main")
        normalized.append(comparable)
    assert all(result == normalized[0] for result in normalized), (
        "Python/Rust configuration results differ outside the documented implementation differences"
    )
    if args.output:
        args.output.write_text(json.dumps(evidence, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    invoked = os.environ.get("ACCEPTANCE_TOOL", "")
    raise SystemExit(
        gh_fixture(sys.argv[1:])
        if invoked == "gh"
        else git_fixture(sys.argv[1:])
        if invoked == "git"
        else main()
    )
