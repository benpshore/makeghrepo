#!/usr/bin/env python3
"""Regenerate the beta payload allowlist from tracked shared package files."""

import argparse
import json
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    result = subprocess.run(
        ["git", "ls-files", "-z", "--", "src/makeghrepo"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=True,
    )
    tracked = result.stdout.split("\x00")
    files = sorted(name.removeprefix("src/makeghrepo/") for name in tracked if name)
    if "registry.py" not in files:
        raise SystemExit("cannot find tracked shared package sources")
    text = json.dumps({"schema": 1, "files": files}, indent=2, sort_keys=True) + "\n"
    manifest = ROOT / "beta/shared-files.json"
    if args.check:
        if manifest.read_text() != text:
            raise SystemExit("beta source manifest is stale; run python scripts/regen-beta-sources")
    else:
        manifest.write_text(text)


if __name__ == "__main__":
    main()
