#!/usr/bin/env python3
"""Print the `templates` job matrix as JSON (see golden_snapshots.ci_matrix)."""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "tests"))

import golden_snapshots  # noqa: E402

print(json.dumps(golden_snapshots.ci_matrix(), separators=(",", ":")))
