#!/usr/bin/env python3
"""Regenerate tests/golden/*.golden from the current templates.

Run from the repo root:  uv run scripts/regen-golden [--check] [--out DIR]
Then review `git diff tests/golden` before committing. Never edit .golden files by hand.
CI runs this with --out and uploads the result as the `golden` artifact.
"""

import argparse
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "tests"))

import golden_snapshots


def main() -> int:
    parser = argparse.ArgumentParser(description="Regenerate the golden snapshots.")
    parser.add_argument(
        "--check", action="store_true", help="write nothing; exit 1 if anything would change"
    )
    parser.add_argument(
        "--out", type=Path, default=golden_snapshots.GOLDEN_DIR, help="output directory"
    )
    args = parser.parse_args()

    wanted: dict[str, bytes] = {}
    with tempfile.TemporaryDirectory() as tmp:
        for name in golden_snapshots.COMBOS:
            parent = Path(tmp) / name
            parent.mkdir()
            rendered = golden_snapshots.render_combo(name, parent / "quiet-otter")
            wanted[f"{name}.golden"] = golden_snapshots.serialize(rendered).encode("utf-8")

    out: Path = args.out
    entries = list(out.iterdir()) if out.is_dir() and not out.is_symlink() else []
    unexpected = sorted(
        p.name for p in entries if p.name not in wanted or p.is_symlink() or not p.is_file()
    )
    existing = {
        p.name: p.read_bytes() for p in entries if p.name in wanted and p.name not in unexpected
    }
    changed = [n for n, data in wanted.items() if existing.get(n) != data]

    if args.check:
        for name in [*changed, *unexpected]:
            print(f"would change: {name}")
        return 1 if changed or unexpected else 0

    # Only a dedicated snapshot directory may be updated. Never delete a
    # caller-supplied tree, or follow a directory/file symlink during writes.
    if out.is_symlink() or (out.exists() and not out.is_dir()) or unexpected:
        print(f"refusing to replace non-dedicated snapshot directory: {out}", file=sys.stderr)
        return 1
    out.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".golden-", dir=out.parent) as staging:
        for name, data in wanted.items():
            (Path(staging) / name).write_bytes(data)
        out.mkdir(exist_ok=True)
        for name in wanted:
            (Path(staging) / name).replace(out / name)
    print(f"{len(wanted)} written")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
