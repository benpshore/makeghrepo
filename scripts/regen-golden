#!/usr/bin/env bash
# Regenerate the golden snapshots in tests/golden/ from the current templates, then check
# them. Run this whenever you intend to change rendered output, and review the diff.
# Never edit or merge golden files by hand: on a conflict, rebase and re-run this.
# Extra arguments go to pytest, e.g. `scripts/regen-golden -k python`.
set -euo pipefail
cd "$(dirname "$0")/.."

uv run pytest tests/test_golden.py -q --update-golden "$@"
uv run pytest tests/test_golden.py -q "$@"

# A .gitignore (ours, or one inside a rendered project) would keep a golden file out of
# commits, and CI would then fail on the missing file.
ignored=$(git ls-files --others --ignored --exclude-standard -- tests/golden)
if [[ -n "$ignored" ]]; then
    printf 'these golden files are gitignored, so they would never be committed:\n%s\n' \
        "$ignored" >&2
    exit 1
fi
echo "tests/golden is up to date. Review it with: git status tests/golden; git diff tests/golden"
