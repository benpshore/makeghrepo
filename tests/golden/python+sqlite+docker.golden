### FILE pyproject.toml exec=0 bytes=929 encoding=utf-8
[project]
name = "quiet-otter"
dynamic = ["version"]
description = "a test project"
readme = "README.md"
license = "MIT"
authors = [{ name = "Test User" }]
requires-python = ">=3.14"
dependencies = []

[project.scripts]
quiet-otter = "quiet_otter:main"

# The version is the git tag (v1.2.3 -> 1.2.3); nothing to bump by hand.
[build-system]
requires = ["hatchling>=1.32,<2", "uv-dynamic-versioning>=0.14,<1"]
build-backend = "hatchling.build"

[tool.hatch.version]
source = "uv-dynamic-versioning"

[tool.hatch.build.targets.wheel]
packages = ["src/quiet_otter"]

[tool.uv-dynamic-versioning]
fallback-version = "0.0.0"

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.14"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "RUF", "S"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["-ra", "--strict-markers"]

### END
### FILE sqlite/schema.sql exec=0 bytes=644 encoding=utf-8
-- Schema for the app's SQLite database. Applied to a fresh database on first
-- start; keep it idempotent. The file lives at ${APP_DATA:-.}/app.db, so with
-- Docker it sits on the appdata volume.
PRAGMA journal_mode = WAL;
PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS schema_version (
    version INTEGER PRIMARY KEY,
    applied_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
);

CREATE TABLE IF NOT EXISTS items (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
);

INSERT OR IGNORE INTO schema_version (version) VALUES (1);

### END
