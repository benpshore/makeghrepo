### FILE AGENTS.md exec=0 bytes=415 encoding=utf-8
# quiet-otter

- `main` is protected. Work on a branch and open a PR (`gh pr create --fill`); the `ci` check must pass.
- Never commit secrets, `.env` files, databases or `.DS_Store` (see `.gitignore`; CI rejects them).
- Before committing, run:

```sh
cmake -S . -B build && cmake --build build && ctest --test-dir build
docker build -t quiet-otter . && docker compose up -d app   # data volume: appdata:/data
```

### END
### FILE CLAUDE.md exec=0 bytes=11 encoding=utf-8
@AGENTS.md

### END
### FILE CMakeLists.txt exec=0 bytes=463 encoding=utf-8
cmake_minimum_required(VERSION 3.25)
project(quiet_otter LANGUAGES C CXX)

set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(CMAKE_C_STANDARD 17)
set(CMAKE_CXX_STANDARD 20)
enable_testing()

function(add_program target source)
  add_executable(${target} ${source})
  target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
  add_test(NAME ${target} COMMAND ${target})
endfunction()

add_program(quiet_otter_c src/main.c)
add_program(quiet_otter_cpp src/main.cpp)

### END
### FILE Dockerfile exec=0 bytes=436 encoding=utf-8
FROM debian:bookworm-slim AS build
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build

FROM debian:bookworm-slim
COPY --from=build /app/build/quiet_otter_cpp /usr/local/bin/app
ENV APP_DATA=/data
VOLUME ["/data"]
USER 65534:65534
CMD ["app"]

### END
