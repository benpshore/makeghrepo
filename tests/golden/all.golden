authors = [{ name = "Test User" }]
requires-python = ">=3.14"
dependencies = []

[project.scripts]
quiet-otter = "quiet_otter:main"

[build-system]
requires = ["uv_build>=0.9,<1"]
build-backend = "uv_build"

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.14"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "RUF", "S"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["-ra", "--strict-markers"]

### END
### FILE scripts/hello.sh exec=1 bytes=70 encoding=utf-8
#!/usr/bin/env bash
set -euo pipefail

echo "Hello from quiet-otter!"

### END
