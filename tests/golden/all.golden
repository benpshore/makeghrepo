    get:
      operationId: getHealth
      summary: Liveness check
      description: Returns ok when the service is up.
      tags: [health]
      responses:
        "200":
          description: Service is up
          content:
            application/json:
              schema:
                type: object
                required: [status]
                properties:
                  status:
                    type: string
                    const: ok

