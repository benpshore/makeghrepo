### FILE compose.yaml exec=0 bytes=472 encoding=utf-8
# Local development database only. Credentials here are not secrets.
services:
  db:
    image: postgres:17
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: app
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./db/migrations:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app"]
      interval: 2s
      retries: 15

volumes:
  pgdata:

### END
### FILE db/migrations/0001_init.sql exec=0 bytes=237 encoding=utf-8
-- Migrations run in filename order: in CI, and on first `docker compose up`.
create table if not exists app_meta (
    setting_name text primary key,
    setting_value text not null,
    updated_at timestamptz not null default now()
);

