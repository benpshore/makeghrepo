### FILE test/index.test.js exec=0 bytes=191 encoding=utf-8
import assert from "node:assert/strict";
import { test } from "node:test";

import { greeting } from "../src/index.js";

test("greets", () => {
  assert.match(greeting(), /quiet-otter/);
});

### END
### FILE tests/test_smoke.py exec=0 bytes=124 encoding=utf-8
import quiet_otter


def test_main_runs(capsys):
    quiet_otter.main()
    assert "quiet-otter" in capsys.readouterr().out

