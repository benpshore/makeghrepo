### FILE src/main.mm exec=0 bytes=201 encoding=utf-8
#import <Foundation/Foundation.h>
#include <string>

int main() {
    @autoreleasepool {
        std::string name = "quiet-otter";
        NSLog(@"Hello from %s!", name.c_str());
    }
    return 0;
}

### END
### FILE src/main.rs exec=0 bytes=262 encoding=utf-8
fn greeting() -> String {
    String::from("Hello from quiet-otter!")
}

fn main() {
    println!("{}", greeting());
}

#[cfg(test)]
mod tests {
    use super::greeting;

    #[test]
    fn greets() {
        assert!(greeting().contains("quiet-otter"));
    }
}

### END
