### FILE README.md exec=0 bytes=297 encoding=utf-8
# quiet-otter

a test project

## Checks

Run these before opening a PR. CI runs the same ones.

```sh
uv run ruff format && uv run ruff check && uv run pytest && uv audit --preview-features audit-command
```

`main` is protected: open a PR; the `ci` check must pass before merging (squash only).

### END
### FILE SECURITY.md exec=0 bytes=213 encoding=utf-8
# Security Policy

Please report vulnerabilities privately via
**Security → Report a vulnerability** on this repository (GitHub private vulnerability reporting).
Do not open public issues for security problems.

### END
### FILE pyproject.toml exec=0 bytes=911 encoding=utf-8
[project]
name = "quiet-otter"
dynamic = ["version"]
description = "a test project"
readme = "README.md"
license = "MIT"
authors = [{ name = "Test User" }]
requires-python = ">=3.14"
dependencies = []

[project.scripts]
quiet-otter = "quiet_otter:main"

# The version is the git tag (v1.2.3 -> 1.2.3); nothing to bump by hand.
[build-system]
requires = ["hatchling", "uv-dynamic-versioning"]
build-backend = "hatchling.build"

[tool.hatch.version]
source = "uv-dynamic-versioning"

[tool.hatch.build.targets.wheel]
packages = ["src/quiet_otter"]

[tool.uv-dynamic-versioning]
fallback-version = "0.0.0"

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.14"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "RUF", "S"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["-ra", "--strict-markers"]

### END
